{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@kandev/plugin-sdk": ["../../kandev/apps/packages/plugin-sdk/src/index.ts"]
    },
    "types": [
      "vitest/globals"
    ]
  },
  "include": [
    "src",
    "build.mjs"
  ]
}
